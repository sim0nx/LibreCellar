# Release signing for LibreCellar. Copy to keystore.properties (git-ignored) and fill in.
# A value left empty falls back to the environment variable named in the comment above it.

# KEYSTORE_PATH; "~" is your home directory
storeFile=~/path/to/upload-keystore.jks
# KEY_ALIAS
keyAlias=upload
# STORE_PASSWORD
storePassword=
# KEY_PASSWORD
keyPassword=
