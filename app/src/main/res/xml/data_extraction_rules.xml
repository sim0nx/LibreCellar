<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12 and newer (Auto Backup and device-to-device transfer).
   Settings are kept; bottle and label photos stay on the phone, they are loaded again from the
   server. The login token is backed up encrypted, but its key never leaves the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="bottle_cache/" />
        <exclude domain="file" path="bottle_photos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="bottle_cache/" />
        <exclude domain="file" path="bottle_photos/" />
    </device-transfer>
</data-extraction-rules>
