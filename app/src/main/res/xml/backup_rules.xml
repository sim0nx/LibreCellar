<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and older, same as data_extraction_rules.xml: settings are kept,
   bottle and label photos stay on the phone.
-->
<full-backup-content>
    <exclude domain="file" path="bottle_cache/" />
    <exclude domain="file" path="bottle_photos/" />
</full-backup-content>
